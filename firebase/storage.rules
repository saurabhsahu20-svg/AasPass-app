rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function allowedType() {
      return request.resource.contentType in [
        'image/jpeg', 'image/png', 'image/webp', 'video/mp4',
        'application/pdf', 'audio/mp4', 'audio/aac', 'audio/mpeg'
      ];
    }
    function uploadAllowed(uid) {
      return signedIn() && request.auth.uid == uid && resource == null
        && request.resource.size > 0 && request.resource.size <= 20 * 1024 * 1024
        && allowedType();
    }
    function chatAllowed(cid) {
      let chat = firestore.get(/databases/(default)/documents/conversations/$(cid)).data;
      return signedIn() && chat.status == 'accepted'
        && request.auth.uid in chat.participants;
    }
    function groupAllowed(gid) {
      let group = firestore.get(/databases/(default)/documents/groups/$(gid)).data;
      return signedIn() && request.auth.uid in group.members;
    }
    match /media/direct/{cid}/{uid}/{assetId} {
      allow get: if chatAllowed(cid);
      allow list: if false;
      allow create: if uploadAllowed(uid) && chatAllowed(cid)
        && assetId.matches('^[A-Za-z0-9]{20}$');
      allow update, delete: if false;
    }
    match /media/group/{gid}/{uid}/{assetId} {
      allow get: if groupAllowed(gid);
      allow list: if false;
      allow create: if uploadAllowed(uid) && groupAllowed(gid)
        && assetId.matches('^[A-Za-z0-9]{20}$');
      allow update, delete: if false;
    }
    match /{any=**} { allow read, write: if false; }
  }
}
