rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function loggedIn() { return request.auth != null; }
    function isSelf(uid) { return loggedIn() && request.auth.uid == uid; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function handlePath(handle) { return /databases/$(database)/documents/usernames/$(handle); }
    function convPath(cid) { return /databases/$(database)/documents/conversations/$(cid); }
    function validName(name) { return name is string && name.size() >= 2 && name.size() <= 50; }
    function validHandle(handle) { return handle is string && handle.matches('^[a-z0-9_]{3,20}$'); }
    function validMessageId(mid) { return mid is string && mid.matches('^[A-Za-z0-9]{20}$'); }
    function participant(cid) {
      return loggedIn() && request.auth.uid in get(convPath(cid)).data.participants;
    }
    function accepted(cid) {
      return participant(cid) && get(convPath(cid)).data.status == 'accepted';
    }
    function peerFor(members) {
      return members[0] == request.auth.uid ? members[1] : members[0];
    }
    function notBlockedByEither(cid) {
      let members = get(convPath(cid)).data.participants;
      let peer = peerFor(members);
      return !(peer in get(userPath(request.auth.uid)).data.blockedUids)
        && !(request.auth.uid in get(userPath(peer)).data.blockedUids);
    }

    match /users/{uid} {
      // Private account documents include block lists: NEVER make them publicly readable.
      // Only the public usernames document can be looked up by an allowed discoverer.
      allow get: if isSelf(uid);
      allow list: if false;
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'username', 'discoverable', 'blockedUids', 'createdAt'])
        && validName(request.resource.data.displayName)
        && validHandle(request.resource.data.username)
        && request.resource.data.discoverable == false
        && request.resource.data.blockedUids == []
        && request.resource.data.createdAt == request.time
        && getAfter(handlePath(request.resource.data.username)).data.uid == uid
        && getAfter(handlePath(request.resource.data.username)).data.displayName == request.resource.data.displayName;
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'discoverable', 'blockedUids'])
        && validName(request.resource.data.displayName)
        && request.resource.data.username == resource.data.username
        && request.resource.data.discoverable is bool
        && request.resource.data.blockedUids is list
        && request.resource.data.blockedUids.size() <= 100
        && getAfter(handlePath(resource.data.username)).data.discoverable == request.resource.data.discoverable
        && getAfter(handlePath(resource.data.username)).data.displayName == request.resource.data.displayName;
      allow delete: if false; // Full erasure requires verified server-side deletion.
    }

    match /usernames/{handle} {
      allow get: if loggedIn() && (resource.data.uid == request.auth.uid || resource.data.discoverable == true);
      allow list: if false;
      allow create: if loggedIn() && validHandle(handle)
        && request.resource.data.keys().hasOnly(['uid', 'discoverable', 'displayName'])
        && request.resource.data.keys().hasAll(['uid', 'discoverable', 'displayName'])
        && validName(request.resource.data.displayName)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.discoverable == false
        && getAfter(userPath(request.auth.uid)).data.username == handle
        && getAfter(userPath(request.auth.uid)).data.displayName == request.resource.data.displayName;
      allow update: if loggedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['discoverable', 'displayName'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.discoverable is bool
        && validName(request.resource.data.displayName)
        && getAfter(userPath(request.auth.uid)).data.discoverable == request.resource.data.discoverable
        && getAfter(userPath(request.auth.uid)).data.displayName == request.resource.data.displayName;
      allow delete: if false;
    }

    match /conversations/{cid} {
      allow get, list: if loggedIn() && request.auth.uid in resource.data.participants;
      allow create: if loggedIn()
        && request.resource.data.keys().hasOnly(['participants', 'labels', 'requestedBy', 'status', 'type', 'lastMessage', 'lastAt', 'createdAt'])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && cid == request.resource.data.participants[0] + '_' + request.resource.data.participants[1]
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'requested'
        && request.resource.data.type == 'direct'
        && request.resource.data.labels is map
        && request.resource.data.labels.keys().hasOnly(request.resource.data.participants)
        && request.resource.data.labels.keys().hasAll(request.resource.data.participants)
        && request.resource.data.labels[request.auth.uid] == get(userPath(request.auth.uid)).data.displayName
        && request.resource.data.labels[peerFor(request.resource.data.participants)] == get(userPath(peerFor(request.resource.data.participants))).data.displayName
        && get(userPath(peerFor(request.resource.data.participants))).data.discoverable == true
        && !(request.auth.uid in get(userPath(peerFor(request.resource.data.participants))).data.blockedUids)
        && !(peerFor(request.resource.data.participants) in get(userPath(request.auth.uid)).data.blockedUids)
        && request.resource.data.lastMessage == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastAt == request.time;
      // Only the recipient can accept/decline. The server updates last-message metadata.
      allow update: if loggedIn()
        && request.auth.uid in resource.data.participants
        && request.auth.uid != resource.data.requestedBy
        && resource.data.status == 'requested'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted', 'rejected'];
      allow delete: if false;

      match /messages/{mid} {
        allow get, list: if accepted(cid);
        allow create: if accepted(cid) && notBlockedByEither(cid)
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'replyToId', 'createdAt'])
          && request.resource.data.keys().hasAll(['senderId', 'text', 'replyToId', 'createdAt'])
          && request.resource.data.replyToId is string
          && (request.resource.data.replyToId == '' ||
              (validMessageId(request.resource.data.replyToId) &&
               exists(/databases/$(database)/documents/conversations/$(cid)/messages/$(request.resource.data.replyToId))))
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 3000
          && request.resource.data.createdAt == request.time;
        // An author may edit for 15 minutes or soft-delete their own message.
        // Clients can never change sender, creation time, reply target, or deletion marker.
        allow update: if accepted(cid) && request.auth.uid == resource.data.senderId
          && !('deletedAt' in resource.data)
          && !('mediaPath' in resource.data)
          && (
            (notBlockedByEither(cid)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
              && request.time <= resource.data.createdAt + duration.value(15, 'm')
              && request.resource.data.editedAt == request.time
              && request.resource.data.text is string
              && request.resource.data.text.size() >= 1
              && request.resource.data.text.size() <= 3000)
            ||
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'deletedAt'])
              && request.resource.data.deletedAt == request.time
              && request.resource.data.text == '')
          );
        allow delete: if false;
      }

      match /reads/{readerUid} {
        allow get, list: if accepted(cid);
        allow create, update: if accepted(cid) && isSelf(readerUid)
          && request.resource.data.keys().hasOnly(['readAt'])
          && request.resource.data.keys().hasAll(['readAt'])
          && request.resource.data.readAt == request.time;
        allow delete: if false;
      }
    }

    match /reports/{rid} {
      allow create: if loggedIn()
        && request.resource.data.keys().hasOnly(['reporterUid', 'reportedUid', 'conversationId', 'reason', 'createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.conversationId is string
        && participant(request.resource.data.conversationId)
        && request.resource.data.reportedUid != request.auth.uid
        && request.resource.data.reportedUid in get(convPath(request.resource.data.conversationId)).data.participants
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    match /pushTokens/{uid}/devices/{deviceId} {
      allow get, list: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['token', 'updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() >= 20
        && request.resource.data.token.size() <= 1000
        && request.resource.data.updatedAt == request.time;
      allow delete: if isSelf(uid);
    }

    // Group writes and membership changes are server-only callable actions.
    // Only existing members may query group details or message history.
    match /groups/{gid} {
      allow get, list: if loggedIn() && request.auth.uid in resource.data.members;
      allow create, update, delete: if false;

      match /messages/{mid} {
        function group() {
          return get(/databases/$(database)/documents/groups/$(gid)).data;
        }
        function isMember() {
          return loggedIn() && request.auth.uid in group().members;
        }
        allow get, list: if isMember();
        allow create: if isMember()
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'kind', 'createdAt'])
          && request.resource.data.keys().hasAll(['senderId', 'text', 'kind', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 3000
          && request.resource.data.kind in ['text', 'announcement']
          && (request.resource.data.kind == 'text' || request.auth.uid in group().admins)
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // Invites do not expose a private group's complete member list.
    // Admin SDK callables alone create/respond to invites, preventing membership forgery.
    match /groupInvites/{iid} {
      allow get, list: if loggedIn()
        && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // Authenticated call participants only. Start/answer/end are server callables;
    // clients are allowed to write only their role-specific SDP and ICE candidates.
    match /calls/{callId} {
      function callParticipant() {
        return loggedIn() && request.auth.uid in resource.data.participants;
      }
      allow get, list: if callParticipant();
      allow create, delete: if false;
      allow update: if callParticipant() && (
        (request.auth.uid == resource.data.callerUid
          && resource.data.status in ['ringing', 'accepted']
          && !('offer' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offer'])
          && request.resource.data.offer is string
          && request.resource.data.offer.size() >= 1
          && request.resource.data.offer.size() <= 65536)
        ||
        (request.auth.uid == resource.data.calleeUid
          && resource.data.status == 'accepted'
          && !('answer' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer'])
          && request.resource.data.answer is string
          && request.resource.data.answer.size() >= 1
          && request.resource.data.answer.size() <= 65536)
      );
      match /candidates/{candidateId} {
        function parentCall() {
          return get(/databases/$(database)/documents/calls/$(callId)).data;
        }
        function activeParticipant() {
          return loggedIn() && request.auth.uid in parentCall().participants
            && parentCall().status in ['ringing', 'accepted'];
        }
        allow get, list: if loggedIn() && request.auth.uid in parentCall().participants;
        allow create: if activeParticipant()
          && request.resource.data.keys().hasOnly(['senderUid', 'sdp', 'sdpMid', 'sdpMLineIndex', 'createdAt'])
          && request.resource.data.keys().hasAll(['senderUid', 'sdp', 'sdpMid', 'sdpMLineIndex', 'createdAt'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.sdp is string
          && request.resource.data.sdp.size() >= 1
          && request.resource.data.sdp.size() <= 8192
          && request.resource.data.sdpMid is string
          && request.resource.data.sdpMid.size() <= 100
          && request.resource.data.sdpMLineIndex is int
          && request.resource.data.sdpMLineIndex >= 0
          && request.resource.data.sdpMLineIndex <= 50
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
    match /callRateLimits/{uid} { allow read, write: if false; }
    match /deletionJobs/{uid} { allow read, write: if false; }

    match /{document=**} { allow read, write: if false; }
  }
}
